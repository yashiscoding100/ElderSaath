<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:nestedScrollingEnabled="false"
    android:overScrollMode="never"
    android:background="@drawable/bg_alarm_gradient">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:descendantFocusability="beforeDescendants"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="48dp"
        android:paddingBottom="48dp">

        <!-- Top Status Badge -->
        <TextView
            android:id="@+id/tvAlarmBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⏰ ELDERSAATH ALARM"
            android:textColor="#38BDF8"
            android:textSize="14sp"
            android:textStyle="bold"
            android:letterSpacing="0.08"
            android:gravity="center"
            android:layout_marginBottom="16dp" />

        <!-- Alarm Icon Graphic -->
        <TextView
            android:id="@+id/tvAlarmIcon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🚨"
            android:textSize="56sp"
            android:gravity="center"
            android:layout_marginBottom="20dp" />

        <!-- Title / Medicine Name -->
        <TextView
            android:id="@+id/tvAlarmTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Time for Medicine"
            android:textColor="#FFFFFF"
            android:textSize="26sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="12dp" />

        <!-- Body / Dosage Details -->
        <TextView
            android:id="@+id/tvAlarmBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Please take your scheduled medication."
            android:textColor="#E2E8F0"
            android:textSize="17sp"
            android:gravity="center"
            android:lineSpacingExtra="3dp"
            android:layout_marginBottom="36dp" />

        <!-- Action Buttons Container -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Primary STOP / TAKE MEDICINE Button -->
            <Button
                android:id="@+id/btnStopAlarm"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="64dp"
                android:clickable="true"
                android:focusable="true"
                android:stateListAnimator="@null"
                android:text="TAKE MEDICINE / STOP ALARM"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold"
                android:background="@drawable/bg_alarm_stop_btn"
                android:paddingTop="16dp"
                android:paddingBottom="16dp"
                android:layout_marginBottom="16dp"
                android:elevation="6dp" />

            <!-- Secondary SNOOZE Button -->
            <Button
                android:id="@+id/btnSnoozeAlarm"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="56dp"
                android:clickable="true"
                android:focusable="true"
                android:stateListAnimator="@null"
                android:text="I'LL TAKE MEDICINES LATER (10M)"
                android:textColor="#F1F5F9"
                android:textSize="15sp"
                android:textStyle="bold"
                android:background="@drawable/bg_alarm_snooze_btn"
                android:paddingTop="15dp"
                android:paddingBottom="15dp"
                android:elevation="3dp" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
